ARG BASE_IMAGE=nvidia/cuda:13.0.1-devel-ubuntu24.04
ARG DCGM_VERSION=4.4.0-1
FROM ${BASE_IMAGE} AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG TRITON_BUILD_TYPE=RelWithDebInfo
ARG TRITON_INSTALL_PREFIX=/workspace/build/triton-core/install
ARG TRITON_CORE_HEADERS_ONLY=OFF
# Default: enable all optional features
ARG TRITON_ENABLE_GPU=ON
ARG TRITON_ENABLE_NVTX=ON
ARG TRITON_ENABLE_TRACING=ON
ARG TRITON_ENABLE_LOGGING=ON
ARG TRITON_ENABLE_STATS=ON
ARG TRITON_ENABLE_METRICS=ON
ARG TRITON_ENABLE_METRICS_GPU=ON
ARG TRITON_ENABLE_METRICS_CPU=ON
ARG TRITON_ENABLE_GCS=ON
ARG TRITON_ENABLE_S3=ON
ARG TRITON_ENABLE_AZURE_STORAGE=ON
ARG TRITON_ENABLE_ENSEMBLE=ON
ARG TRITON_ENABLE_MALI_GPU=ON
ARG TRITON_MIN_CXX_STANDARD=17
ARG TRITON_THIRD_PARTY_INSTALL_PREFIX=/workspace/third-party
ARG BUILD_CMAKE_FLAGS=""

# Install base packages and Kitware apt for newer CMake
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates \
    gnupg \
    wget \
    lsb-release \
    software-properties-common \
    build-essential \
    git \
    curl \
    unzip \
    pkg-config \
     python3 \
     python3-dev \
    python3-venv \
    python3-pip \
    ninja-build \
    zlib1g-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    autoconf \
    automake \
    libtool \
    libre2-dev \
    libb64-dev \
    libgoogle-perftools-dev \
    libjemalloc-dev \
    libnuma-dev \
    rapidjson-dev \
    scons \
    libarchive-dev \
    libxml2-dev \
    python3-wheel \
    python3-setuptools \
 && rm -rf /var/lib/apt/lists/*

# Install modern CMake from Kitware APT
RUN apt-get update \
 && wget -O - "https://apt.kitware.com/keys/kitware-archive-latest.asc" | apt-key add - \
 && DISTRO="$(lsb_release -cs)" \
 && echo "deb https://apt.kitware.com/ubuntu/ ${DISTRO} main" > /etc/apt/sources.list.d/kitware.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends cmake \
 && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install Python build tools required by wheel build
# and ensure pybind11 can find the Python headers
RUN python3 -m pip install --upgrade pip setuptools wheel build \
    && python3 -m pip install docker virtualenv patchelf==0.17.2

# install boost headers
RUN wget -O /tmp/boost.tar.gz https://archives.boost.org//release/1.80.0/source/boost_1_80_0.tar.gz \
 && (cd /tmp && tar xzf boost.tar.gz) \
 && mv /tmp/boost_1_80_0/boost /usr/include/boost

# Set DCGM version
ENV DCGM_VERSION=4.4.0-1

# Install DCGM libraries (aligned with build.py logic; ubuntu24.04 x86_64)
RUN curl -o /tmp/cuda-keyring.deb \
    https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb \
    && apt install /tmp/cuda-keyring.deb \
    && rm /tmp/cuda-keyring.deb \
    && apt update \
    && apt install --yes --no-install-recommends \
        datacenter-gpu-manager-4-core=1:${DCGM_VERSION} \
        datacenter-gpu-manager-4-dev=1:${DCGM_VERSION} \
    && rm -rf /var/lib/apt/lists/*

# Set DCGM_DIR to help CMake find the DCGM package
ENV DCGM_DIR=/usr/lib/x86_64-linux-gnu

# Create workspace and copy only the core source tree to avoid copying any
# existing build directories from the build context.
WORKDIR /workspace
COPY . /workspace/core

# Ensure consistent CMake policy for third-party subprojects that may
# request older CMake versions. This avoids configure-time policy errors.
ENV CMAKE_POLICY_VERSION_MINIMUM=3.5

# Create a persistent build directory for caching CMake files
# Note: we use Docker BuildKit cache mounts for best performance. When
# building locally enable BuildKit (e.g. export DOCKER_BUILDKIT=1) or use
# "docker buildx build". BuildKit will persist the cache between builds
# even when the image changes, which speeds up CMake configure times.
RUN mkdir -p /workspace/build-cache

# Configure core only (ExternalProject will handle third-party fetch/build)
# Use BuildKit cache mounts to persist CMake and Ninja files between builds.
# These RUN lines will be no-ops if BuildKit is not enabled, so we keep a
# fallback to the plain commands above for compatibility.
RUN --mount=type=cache,id=cmake-cache,target=/workspace/build-cache \
    cmake -S core -B /workspace/build-cache -G Ninja \
    -DCMAKE_BUILD_TYPE=${TRITON_BUILD_TYPE} \
    -DCMAKE_INSTALL_PREFIX=${TRITON_INSTALL_PREFIX} \
    -DTRITON_CORE_HEADERS_ONLY=${TRITON_CORE_HEADERS_ONLY} \
    -DTRITON_ENABLE_GPU=${TRITON_ENABLE_GPU} \
    -DTRITON_ENABLE_NVTX=${TRITON_ENABLE_NVTX} \
    -DTRITON_ENABLE_TRACING=${TRITON_ENABLE_TRACING} \
    -DTRITON_ENABLE_LOGGING=${TRITON_ENABLE_LOGGING} \
    -DTRITON_ENABLE_STATS=${TRITON_ENABLE_STATS} \
    -DTRITON_ENABLE_METRICS=${TRITON_ENABLE_METRICS} \
    -DTRITON_ENABLE_METRICS_GPU=${TRITON_ENABLE_METRICS_GPU} \
    -DTRITON_ENABLE_METRICS_CPU=${TRITON_ENABLE_METRICS_CPU} \
    -DTRITON_ENABLE_GCS=${TRITON_ENABLE_GCS} \
    -DTRITON_ENABLE_S3=${TRITON_ENABLE_S3} \
    -DTRITON_ENABLE_AZURE_STORAGE=${TRITON_ENABLE_AZURE_STORAGE} \
    -DTRITON_ENABLE_ENSEMBLE=${TRITON_ENABLE_ENSEMBLE} \
    -DTRITON_ENABLE_MALI_GPU=${TRITON_ENABLE_MALI_GPU} \
    -DTRITON_MIN_CXX_STANDARD=${TRITON_MIN_CXX_STANDARD} \
    -DTRITON_THIRD_PARTY_INSTALL_PREFIX=${TRITON_THIRD_PARTY_INSTALL_PREFIX} \
    -DCMAKE_POLICY_VERSION_MINIMUM=${CMAKE_POLICY_VERSION_MINIMUM} \
    -DCMAKE_CXX_FLAGS="-fno-omit-frame-pointer" \
    -DCMAKE_C_FLAGS="-fno-omit-frame-pointer" \
    ${BUILD_CMAKE_FLAGS}

# Build and install using the persistent build directory and cache mount
RUN --mount=type=cache,id=cmake-cache,target=/workspace/build-cache \
    cmake --build /workspace/build-cache --config ${TRITON_BUILD_TYPE} -j$(nproc)

RUN --mount=type=cache,id=cmake-cache,target=/workspace/build-cache \
    cmake --install /workspace/build-cache --config ${TRITON_BUILD_TYPE}

# Also declare the build-cache as a VOLUME for non-BuildKit users who prefer
# to bind-mount a host directory at `/workspace/build-cache` during iterative
# development (optional). Keeping the VOLUME doesn't hurt when BuildKit is
# used, and provides a fallback persistence mechanism.
VOLUME /workspace/build-cache

# Final runtime image: copy installed artifacts
FROM ${BASE_IMAGE} AS runtime
LABEL maintainer="triton-core-builder"

COPY --from=builder /workspace/build/triton-core/install /opt/tritonserver

ENV LD_LIBRARY_PATH=/usr/local/cuda/targets/x86_64-linux/lib:/opt/tritonserver/lib:${LD_LIBRARY_PATH:-}
ENV PATH=/opt/tritonserver/bin:$PATH

WORKDIR /opt/tritonserver

CMD ["/bin/bash"]
